{
  "name": "meteo-aggregator",
  "version": "0.1.0",
  "description": "Aggregate multi-source weather forecasts vs. observations for later scoring, city by city.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "prisma db push --skip-generate",
    "db:reset": "bash scripts/db-reset.sh",
    "db:reset:seed": "bash scripts/db-reset.sh && npm run seed",
    "prisma:generate": "prisma generate",
    "seed": "tsx src/cli/seed.ts",
    "daily": "tsx src/cli/daily.ts",
    "geocode": "tsx src/cli/geocode.ts",
    "run-once": "tsx src/cli/runOnce.ts",
    "backfill:obs": "tsx src/cli/backfillObs.ts",
    "reliability": "tsx src/cli/reliability.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "geotiff": "^2.1.3",
    "luxon": "^3.5.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.16.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
