# --- Database ---
DATABASE_URL=postgresql://meteo:meteo@localhost:5432/meteo?schema=public

# --- Time ---
# Default IANA zone for day and time-range boundaries. Towns may override it
# with their own `town.timezone`; this is the fallback when they don't.
TIME_ZONE=Europe/Paris

# --- Meteo-France AROME ---
# Get a key at https://portail-api.meteofrance.fr/ (subscribe to the AROME API).
METEOFRANCE_API_KEY=replace-me
METEOFRANCE_BASE_URL=https://public-api.meteofrance.fr/public/arome/1.0
AROME_PRODUCT=MF-NWP-HIGHRES-AROME-0025-FRANCE

# --- Meteo-France Donnees Climatologiques (DPClim, observations) ---
# Separate subscription from AROME on portail-api.meteofrance.fr; the AROME key
# gets 403 on DPClim. Falls back to METEOFRANCE_API_KEY only if they share a key.
METEOFRANCE_CLIMATOLOGY_API_KEY=replace-me
METEOFRANCE_CLIM_BASE_URL=https://public-api.meteofrance.fr/public/DPClim/v1
CLIM_MAX_REQ_PER_MIN=45
# Daily run backfills observations for J-1 .. J-OBS_LOOKBACK_DAYS (archive lags).
OBS_LOOKBACK_DAYS=3

# --- Geocoding ---
GEOCODER_URL=https://api-adresse.data.gouv.fr/search/
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- Runtime ---
HTTP_CONCURRENCY=4
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=3
# AROME key tier request budget (public tier is typically 50/min); stay under it.
AROME_MAX_REQ_PER_MIN=45
# Sample every Nth hourly step (1 = every hour; 3 = 3-hourly, ~3x fewer requests).
AROME_STEP_HOURS=1
LOG_LEVEL=info
