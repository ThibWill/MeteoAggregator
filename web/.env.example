# Base URL the browser uses to reach the read API.
#
# Leave blank in development: requests go to /api and Vite proxies them to the
# API (see vite.config.ts -> server.proxy). Override the proxy target with
# API_ORIGIN when the API is not on localhost:3000.
#
# In production set this to the API origin the browser can reach, e.g.
#   VITE_API_BASE_URL=https://meteo.example.com
# and make sure API_CORS_ORIGINS on the API allows this site's origin.
VITE_API_BASE_URL=
